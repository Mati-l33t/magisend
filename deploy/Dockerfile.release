# MagiSend container image from the signed release binaries; the Docker
# workflow verifies them and puts them in release-bin/linux-<arch>/ first.
# To build from source instead, use the Dockerfile at the top of the repo.

FROM golang:1.27.2-alpine3.24 AS files
RUN apk add --no-cache ca-certificates
ARG TARGETARCH
ARG VERSION
COPY release-bin/linux-${TARGETARCH}/magisend /out/magisend
RUN [ "$(/out/magisend --version)" = "$VERSION" ] \
 && mkdir -p /out/data /out/tmp && chown 10001:10001 /out/data && chmod 1777 /out/tmp

FROM scratch
COPY --from=files /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=files /out/magisend /magisend
COPY LICENSE THIRD-PARTY-NOTICES.md /
COPY --from=files --chown=10001:10001 /out/data /data
COPY --from=files /out/tmp /tmp
ENV MAGISEND_DATA=/data \
    MAGISEND_LISTEN=0.0.0.0:8080 \
    MAGISEND_INSTALL=docker
USER 10001:10001
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD ["/magisend", "--healthcheck"]
ENTRYPOINT ["/magisend"]
